// Local installation without the upstream author's signing identity.
#include "Common.xcconfig"

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
MENUHELPER_ENTITLEMENTS_MenuHelper = Configs/LocalApp.entitlements
MENUHELPER_ENTITLEMENTS_MenuHelperExtension = Configs/LocalExtension.entitlements
CODE_SIGN_ENTITLEMENTS = $(MENUHELPER_ENTITLEMENTS_$(TARGET_NAME))
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
MENUHELPER_FILE_ACCESS_MenuHelper = readonly
MENUHELPER_FILE_ACCESS_MenuHelperExtension = readwrite
ENABLE_USER_SELECTED_FILES = $(MENUHELPER_FILE_ACCESS_$(TARGET_NAME))

PRODUCT_BUNDLE_IDENTIFIER_MenuHelper = com.byrondelgado.MacMenuHelper
PRODUCT_BUNDLE_IDENTIFIER_MenuHelperExtension = com.byrondelgado.MacMenuHelper.MenuHelperExtension
PRODUCT_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_$(TARGET_NAME))
INFOPLIST_KEY_CFBundleDisplayName = Finder Menu Tools
ASSETCATALOG_COMPILER_APPICON_NAME = ForkAppIcon
MENUHELPER_PREFERENCES_DOMAIN = com.byrondelgado.MacMenuHelper.preferences

GCC_GENERATE_TEST_COVERAGE_FILES = NO
GCC_INSTRUMENT_PROGRAM_FLOW_ARCS = NO
CLANG_ENABLE_CODE_COVERAGE = NO
